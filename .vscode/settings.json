    // CMake Tools: configure / build with CMakePresets.json
    "cmake.useCMakePresets": "always",
    // The tests are shown by C++ TestMate (GoogleTest tree, jump to source,
    // inline failures); without this CMake Tools would list every test a second time.
    "cmake.ctest.testExplorerIntegrationEnabled": false,
    "testMate.cpp.test.advancedExecutables": [
        { "pattern": "build/**/airco_*_tests.exe" },
        { "pattern": "build/**/airco_*_tests" }
    ]
