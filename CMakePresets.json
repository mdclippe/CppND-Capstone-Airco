{
    "version": 3,
    "cmakeMinimumRequired": {
        "major": 3,
        "minor": 21,
        "patch": 0
    },
    "configurePresets": [
        {
            "name": "base",
            "hidden": true,
            "binaryDir": "${sourceDir}/build/${presetName}",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Debug",
                "CMAKE_EXPORT_COMPILE_COMMANDS": "ON"
            }
        },
        {
            "name": "default",
            "inherits": "base",
            "displayName": "Qt GUI + tests",
            "description": "Needs Qt: point CMAKE_PREFIX_PATH to e.g. .../Qt/6.5.2/gcc_64 (environment or CMakeUserPresets.json)"
        },
        {
            "name": "no-gui",
            "inherits": "base",
            "displayName": "Without Qt (airco logic + tests)",
            "cacheVariables": {
                "AIRCO_BUILD_GUI": "OFF"
            },
            "condition": {
                "type": "notEquals",
                "lhs": "${hostSystemName}",
                "rhs": "Windows"
            }
        },
        {
            "name": "msvc-no-gui",
            "inherits": "base",
            "displayName": "MSVC without Qt (airco logic + tests)",
            "generator": "Ninja",
            "architecture": {
                "value": "x64",
                "strategy": "external"
            },
            "toolset": {
                "value": "host=x64",
                "strategy": "external"
            },
            "cacheVariables": {
                "AIRCO_BUILD_GUI": "OFF",
                "CMAKE_C_COMPILER": "cl",
                "CMAKE_CXX_COMPILER": "cl"
            },
            "condition": {
                "type": "equals",
                "lhs": "${hostSystemName}",
                "rhs": "Windows"
            }
        }
    ],
    "buildPresets": [
        {
            "name": "default",
            "configurePreset": "default"
        },
        {
            "name": "no-gui",
            "configurePreset": "no-gui"
        },
        {
            "name": "msvc-no-gui",
            "configurePreset": "msvc-no-gui"
        }
    ],
    "testPresets": [
        {
            "name": "default",
            "configurePreset": "default",
            "output": {
                "outputOnFailure": true
            }
        },
        {
            "name": "no-gui",
            "configurePreset": "no-gui",
            "output": {
                "outputOnFailure": true
            }
        },
        {
            "name": "msvc-no-gui",
            "configurePreset": "msvc-no-gui",
            "output": {
                "outputOnFailure": true
            }
        }
    ]
}
